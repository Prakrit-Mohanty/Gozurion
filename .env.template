
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-d968ead4-5f5e-483b-a6de-9e3a4ba1199c
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-d968ead4-5f5e-483b-a6de-9e3a4ba1199c

# Report storage (storage/factory.py) - only "s3" exists today, but the
# scanner/agent only ever talk to storage.base.ReportStorage, never this
# flag directly. Leave S3_ENDPOINT_URL blank for real AWS S3.
# `docker compose up -d minio minio-setup` for local dev (buckets:
# workflows, activities, reports).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=reports

# scanner/export.py - which scanners run (see scanner/export.py's
# _SCANNERS). semgrep/trivy are local CLI tools, no server/token needed.
# sonarqube is disabled by default to avoid running that container.
ENABLED_SCANNERS=semgrep,trivy
SCAN_TARGET=.
SEMGREP_CONFIG=auto
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM

# self-hosted SonarQube only - only read if "sonarqube" is in ENABLED_SCANNERS.
SONAR_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

TICKET_BACKEND=jira
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Postgres - ticket_claims idempotency/dedupe ledger, single source of
# truth across branches/repos. `docker compose up postgres` for local dev.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gozurion
POSTGRES_PASSWORD=gozurion
POSTGRES_DB=gozurion

# GitHub API token - used for commit-ancestry checks on reopening a closed
# ticket (org-wide read access to compare commits across repos).
GITHUB_TOKEN=
