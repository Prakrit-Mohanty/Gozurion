
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-d968ead4-5f5e-483b-a6de-9e3a4ba1199c
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-d968ead4-5f5e-483b-a6de-9e3a4ba1199c

# Report storage (storage/factory.py) - only "s3" exists today, but the
# scanner/agent only ever talk to storage.base.ReportStorage, never this
# flag directly. Real AWS S3: leave S3_ENDPOINT_URL/S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY blank and set AWS_PROFILE (SSO via ~/.aws/config -
# `aws sso login --profile <name>` first) so boto3's default credential
# chain picks it up. Local MinIO instead: `docker compose up -d minio
# minio-setup` (buckets: workflows, activities, reports), then set
# S3_ENDPOINT_URL=http://localhost:9010, S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY=minioadmin.
STORAGE_BACKEND=s3
AWS_PROFILE=
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=reports

# scanner/export.py - which scanners run (see scanner/export.py's
# _SCANNERS). semgrep/trivy are local CLI tools, no server/token needed.
# sonarqube is disabled by default to avoid running that container.
ENABLED_SCANNERS=semgrep,trivy
SCAN_TARGET=.
SEMGREP_CONFIG=auto
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM

# self-hosted SonarQube only - only read if "sonarqube" is in ENABLED_SCANNERS.
SONAR_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# Optional - scanner/git_context.py's default_branch lookup via GitHub's
# API. Works unauthenticated for public repos; needed for private ones.
GITHUB_TOKEN=

# jira_url is a trigger input now (src/agent/metadata.json), not read from env.
TICKET_BACKEND=jira
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
